// Run time polymorphism
class Main{
    void vehicle(){
        System.out.println("Car is a four Wheeler");
    } 
}
class Bike extends Main{
    @Override
    void vehicle(){
        System.out.println("Bike is two wheeler");
    }
}
class Bicycle extends Main{
    @Override
    void vehicle(){
        System.out.println("Bicycle is two wheeler");
    }
}
public class poly{
    public static void main(String[] args){
        Bike b = new Bike();
        b.vehicle();
        Bicycle bi = new Bicycle();
        bi.vehicle();
    }
}
