class CalculateArea{
    int area(int l, int b){
        return l*b;
    }
    int area(int a ){
        return a*a;
    }
    double area(double r){
        return 3.14*r*r;
    }
}
public class Main{
    public static void main(String[] args ){
        CalculateArea s = new CalculateArea();
        System.out.println("Area of rectangle = " + s.area(10,20));
        System.out.println("Area of Square = " + s.area(2));
        System.out.println("Area of circle = " + s.area(3.98));
    }
}
